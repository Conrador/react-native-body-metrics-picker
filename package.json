{
  "name": "react-native-body-metrics-picker",
  "version": "0.1.0",
  "description": "Beautiful, reusable body metrics pickers for React Native — height, weight, age",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "build": "bob build",
    "prepare": "bob build",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' '*.json' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' '*.json' '*.md'"
  },
  "keywords": [
    "react-native",
    "picker",
    "height",
    "weight",
    "age",
    "body-metrics",
    "ruler",
    "fitness",
    "health",
    "onboarding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/user/react-native-body-metrics-picker"
  },
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-gesture-handler": ">=2.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "^5.0.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "react-native-builder-bob": "^0.23.0",
    "react-native-reanimated": "^3.8.0",
    "react-native-gesture-handler": "^2.16.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
