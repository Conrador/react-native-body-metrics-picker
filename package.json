{
  "name": "react-native-body-metrics-picker",
  "version": "0.1.0",
  "description": "Native Fabric height ruler (plus optional Reanimated cm/ft switcher) for React Native.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/conrador/react-native-body-metrics-picker"
  },
  "license": "MIT",
  "author": "",
  "keywords": [
    "react-native",
    "fabric",
    "height",
    "ruler",
    "picker",
    "body-metrics",
    "native-ui"
  ],
  "engines": {
    "node": ">=18"
  },
  "codegenConfig": {
    "name": "RNBodyMetricsPickerSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.reactnativebodymetricspicker"
    },
    "ios": {
      "componentProvider": {
        "HeightRulerView": "RCTHeightRulerView"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "react-native-body-metrics-picker.podspec",
    "README.md",
    "LICENSE",
    "!**/__tests__"
  ],


  "scripts": {
    "typescript": "tsc --noEmit",
    "build": "bob build",
    "prepublishOnly": "bob build",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' '*.json' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' '*.json' '*.md'"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "prettier": "^3.2.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "^0.23.0",
    "react-native-reanimated": "^4.3.0",
    "react-native-worklets": "^0.8.1",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
